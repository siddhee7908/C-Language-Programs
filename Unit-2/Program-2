Write a C program to accept a number from the user and check whether the given number is even or odd.
#include<stdio.h>
int main()
{
    int num;
    printf("Enter a number: ");
    scanf("%d", &num);
    if(num % 2 == 0)
    {
        printf("%d is an Even number.\n", num);
    }
    else
    {
        printf("%d is an Odd number.\n", num);
    }
    return 0;
}
#Output
Enter a number: 25
25 is an Odd number.