#Write a C program to demonstrate the order of execution of operators in an expression using operator 
precedence and associativity.  
#include<stdio.h>
int main()
{
    int a=10,b=5,c=2;
    int result;
    result=a+b*c;
    printf("Expression:a+b*c\n");
    printf("a=%d,b=%d,c=%d\n",a,b,c);
    printf("Result=%d\n",result);
    return 0;
}
