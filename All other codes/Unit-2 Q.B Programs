#23# Wirte a program Calculate Area of Square, Rectangle, Triangle and Circle using Menu
#include <stdio.h>

int main() {
    int choice;
    float side, length, breadth, base, height, radius, area;

    printf("1. Square\n");
    printf("2. Rectangle\n");
    printf("3. Triangle\n");
    printf("4. Circle\n");

    printf("Enter your choice: ");
    scanf("%d", &choice);

    switch (choice) {
        case 1:
            printf("Enter side: ");
            scanf("%f", &side);
            area = side * side;
            printf("Area of Square = %.2f", area);
            break;

        case 2:
            printf("Enter length and breadth: ");
            scanf("%f %f", &length, &breadth);
            area = length * breadth;
            printf("Area of Rectangle = %.2f", area);
            break;

        case 3:
            printf("Enter base and height: ");
            scanf("%f %f", &base, &height);
            area = 0.5 * base * height;
            printf("Area of Triangle = %.2f", area);
            break;

        case 4:
            printf("Enter radius: ");
            scanf("%f", &radius);
            area = 3.14 * radius * radius;
            printf("Area of Circle = %.2f", area);
            break;

        default:
            printf("Invalid Choice");
    }

    return 0;
}


