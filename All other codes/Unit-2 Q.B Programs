#16# Write a program for Sum of Even/Odd Numbers from 1 to 25
#include <stdio.h>

int main() {
    int i, evenSum = 0, oddSum = 0;

    for (i = 1; i <= 25; i++) {
        if (i % 2 == 0)
            evenSum += i;
        else
            oddSum += i;
    }

    printf("Sum of Even Numbers = %d\n", evenSum);
    printf("Sum of Odd Numbers = %d", oddSum);

    return 0;
}


