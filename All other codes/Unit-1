#8#Read radius and calculate the area of a circle.
#include <stdio.h>
#define PI 3.14159

int main()
{
    float radius, area;
    printf("Enter the radius of the circle: ");
    scanf("%f", &radius);
    area = PI * radius * radius;
    printf("Area of the circle = %.2f\n", area);
    return 0;
}


#9#Read marks and calculate the percentage.
#include <stdio.h>

int main()
{
    float marks, percentage;
    printf("Enter the marks obtained: ");
    scanf("%f", &marks);
    percentage = marks / 100 * 100;
    printf("Percentage = %.2f\n", percentage);
    return 0;
}


