#2# Write C Program for substraction, multiplication, division and modulus.
#include <stdio.h>
int main() 
{
    int a = 10, b = 5;
    int difference, product, quotient, remainder;

    difference = a - b; // Subtraction
    product = a * b; // Multiplication
    quotient = a / b; // Division
    remainder = a % b; // Modulus

    printf("Given numbers: a = %d, b = %d\n", a, b);
    printf("Difference: %d\n", difference);
    printf("Product: %d\n", product);
    printf("Quotient: %d\n", quotient);
    printf("Remainder: %d\n", remainder);

    return 0;

}


#3# Write a C Program to demonstrate increment and decrement operator
#include <stdio.h>
int main() {
int a = 5, b = 5, c = 5, d = 5;
// Prefix Increment
printf("Initial value of a: %d\n", a);
printf("Prefix Increment (++a): %d\n", ++a); // a becomes 6, prints 6
// Postfix Increment
printf("\nInitial value of b: %d\n", b);
printf("Postfix Increment (b++): %d\n", b++); // prints 5, b becomes 6
printf("Value of b after postfix increment: %d\n", b); // prints 6
// Prefix Decrement
printf("\nInitial value of c: %d\n", c);
printf("Prefix Decrement (--c): %d\n", --c); // c becomes 4, prints 4
// Postfix Decrement
printf("\nInitial value of d: %d\n", d);
printf("Postfix Decrement (d--): %d\n", d--); // prints 5, d becomes 4
printf("Value of d after postfix decrement: %d\n", d); // prints 4
return 0;
}


#4# Write a C Program to demonstrate Assignment operatoers
#include <stdio.h>
int main() {
int a = 10;
printf("Initial value of a = %d\n", a);
a += 5; // a = a + 5 → 15
printf("After a += 5: %d\n", a);
a -= 3; // a = a - 3 → 12
printf("After a -= 3: %d\n", a);
a *= 2; // a = a * 2 → 24
printf("After a *= 2: %d\n", a);
a /= 4; // a = a / 4 → 6
printf("After a /= 4: %d\n", a);
a %= 4; // a = a % 4 → 2
printf("After a %%= 4: %d\n", a);
return 0;
}


