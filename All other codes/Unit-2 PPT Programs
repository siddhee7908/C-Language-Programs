#7# Write a C program for bitwise operators
#include <stdio.h>

int main() {
int a = 5, b = 3;

printf("a = %d, b = %d\n", a, b);
printf("a & b = %d\n", a & b); // 1
printf("a | b = %d\n", a | b); // 7
printf("a ^ b = %d\n", a ^ b); // 6
printf("~a = %d\n", ~a); // -6 (2's complement)
printf("a << 1 = %d\n", a << 1); // 10
printf("a >> 1 = %d\n", a >> 1); // 2
return 0;
}


