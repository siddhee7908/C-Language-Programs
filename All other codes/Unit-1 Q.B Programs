#1# Write a program to accept a student's name, roll number, and branch, then display the details.
#include<stdio.h>
int main()
{
    char name[50], branch[50];
    int roll;

    printf("Enter student's name: ");
    scanf("%s", name);

    printf("Enter roll number: ");
    scanf("%d", &roll);

    printf("Enter branch: ");
    scanf("%s", branch);

    printf("\nStudent Details\n");
    printf("Name: %s\n", name);
    printf("Roll Number: %d\n", roll);
    printf("Branch: %s\n", branch);

    return 0;
}

#2# Write a program to accept two integers and display their sum, difference, product, and quotient.
#include <stdio.h>

int main()
{
    int a, b;

    printf("Enter two integers: ");
    scanf("%d %d", &a, &b);

    printf("Sum = %d\n", a + b);
    printf("Difference = %d\n", a - b);
    printf("Product = %d\n", a * b);
    printf("Quotient = %d\n", a / b);

    return 0;
}

